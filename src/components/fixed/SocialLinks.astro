---
// Abajo a la izquierda: redes sociales.
import { PILL } from '@/consts';
import Instagram from '@/assets/icons/instagram.svg';
import X from '@/assets/icons/x.svg';
import Facebook from '@/assets/icons/facebook.svg';

// TODO: confirmar los perfiles oficiales de la campaña en España.
const redes = [
	{ nombre: 'Instagram', href: 'https://www.instagram.com/spidermanmovie', Icono: Instagram },
	{ nombre: 'X', href: 'https://x.com/SpiderManMovie', Icono: X },
	{ nombre: 'Facebook', href: 'https://www.facebook.com/SpiderManMovie', Icono: Facebook }
];
---

<ul class="pointer-events-auto flex flex-col gap-y-2 sm:flex-row items-center gap-2">
	{
		redes.map(({ nombre, href, Icono }) => (
			<li class="social-item">
				<a
					href={href}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`${nombre} (abre en una pestaña nueva)`}
					class:list={[
						'social-link grid size-12 place-items-center rounded-full',
						PILL
					]}
				>
					<Icono class="size-5" aria-hidden="true" />
				</a>
				{/* Decorativa: el nombre ya va en el `aria-label` del enlace. */}
				<span class="social-tip" aria-hidden="true">{nombre}</span>
			</li>
		))
	}
</ul>

<style>
	.social-item {
		position: relative;
	}

	.social-link {
		transition:
			transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
			background-color 0.2s ease;
	}

	/* Cuelga del `li` y no del enlace: dentro del `<a>` la arrastraría el
	   `scale(1.1)` del hover. */
	.social-tip {
		position: absolute;
		bottom: calc(100% + 0.625rem);
		left: 50%;
		z-index: 1;
		translate: -50% 0;
		transform: translateY(0.5rem);
		padding: 0.375rem 0.75rem;
		border-radius: 999px;
		background-color: color-mix(
			in oklab,
			var(--color-neutral-dark) 80%,
			transparent
		);
		backdrop-filter: blur(12px);
		color: var(--color-neutral-white);
		font-family: var(--font-display);
		font-size: var(--text-body-medium);
		line-height: 1;
		text-transform: uppercase;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 0.2s ease,
			transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* Centrada se salía por la izquierda: el botón mide 48px y vive a 16px del
	   borde (`p-4`), así que la etiqueta más ancha («Instagram», 83px) empezaba
	   en −2px y el `overflow-x: clip` del documento se comía el principio.
	   Por debajo de `md` se ancla al borde izquierdo del botón, que es el único
	   punto desde el que no puede salirse; desde `md` el padding sube a 24px y
	   centrada ya cabe. Va a las tres y no sólo a la primera porque en móvil
	   caen en columna, todas pegadas al mismo borde. */
	@media (max-width: 767px) {
		.social-tip {
			left: 0;
			translate: 0;
		}
	}

	.social-item:has(.social-link:focus-visible) .social-tip {
		opacity: 1;
		transform: none;
	}

	/* Sólo donde el hover es real: en táctil se quedaría pegada tras el tap. */
	@media (hover: hover) {
		.social-item:hover .social-tip {
			opacity: 1;
			transform: none;
		}
	}

	.social-link:hover,
	.social-link:focus-visible {
		transform: scale(1.1);
		background-color: color-mix(
			in oklab,
			var(--color-neutral-dark) 80%,
			transparent
		);
	}

	@media (prefers-reduced-motion: reduce) {
		.social-link {
			transition: background-color 0.2s ease;
		}

		.social-link:hover,
		.social-link:focus-visible {
			transform: none;
		}

		/* La píldora sigue apareciendo, pero sin desplazamiento. */
		.social-tip {
			transform: none;
			transition: opacity 0.2s ease;
		}
	}
</style>
