---
import ResponsiveImage from '@/components/ResponsiveImage.astro'
import { FICHA, REPARTO, SINOPSIS } from '@/data/content'
---

<section id="sinopsis" class="relative grid min-h-screen scroll-mt-20 items-center bg-neutral-black px-6 pb-32 pt-16 md:scroll-mt-0 md:px-14 md:py-24">
    <div
        data-spider-container
        class="pointer-events-none absolute inset-y-0 right-12 hidden w-12 md:right-70 md:block md:w-16 z-10"
        aria-hidden="true"
    >
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-24 md:w-32 -translate-y-4 opacity-60">
            <img src="/images/spider-web.svg" alt="" class="h-auto w-full drop-shadow-[0_0_8px_rgba(255,255,255,0.2)]" />
        </div>

        <div
            data-spider-line
            class="absolute top-0 left-1/2 w-px -translate-x-1/2 bg-linear-to-b from-neutral-white/10 via-neutral-white/40 to-neutral-white/70 origin-top h-0"
        ></div>

        <div
            data-spider
            class="absolute -top-8 left-1/2 w-full -translate-x-1/2 opacity-0 will-change-transform"
        >
            <img src="/images/spider-animate.svg" alt="" class="h-auto w-full opacity-90 drop-shadow-[0_0_12px_rgba(255,255,255,0.25)]" />
        </div>
    </div>

    <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[minmax(0,1fr)_290px] md:gap-24">
        <div>
            <h2 data-sinopsis-anim class="font-display text-title-small uppercase text-neutral-white">
                Spider-Man™: Brand New Day
            </h2>

            <p data-sinopsis-anim class="mt-8 max-w-2xl font-body text-body-medium text-neutral-white/80">
                {SINOPSIS}
            </p>

            <dl data-sinopsis-anim class="mt-16 grid gap-10 sm:grid-cols-2">
                <div class="space-y-8">
                    {
                        FICHA.map(({ titulo, valor }) => (
                            <div>
                                <dt class="font-display text-title-small uppercase text-neutral-white">{titulo}</dt>
                                <dd class="mt-2 font-body text-body-medium text-neutral-white/80">{valor}</dd>
                            </div>
                        ))
                    }
                </div>

                <div>
                    <dt class="font-display text-title-small uppercase text-neutral-white">Reparto</dt>
                    <dd class="mt-2 max-w-xs font-body text-body-medium text-neutral-white/80">{REPARTO}</dd>
                </div>
            </dl>
        </div>

        <ResponsiveImage
            base="poster"
            widths={[290, 580, 870]}
            sizes="(min-width: 768px) 290px, 100vw"
            width={1080}
            height={1350}
            alt="Cartel de Spider-Man: Brand New Day. Spider-Man salta sobre los rascacielos de Nueva York mientras un grupo de ninjas vestidos de rojo empuña katanas."
            class="h-auto w-full"
            data-sinopsis-poster
        />
    </div>
</section>

<script>
    import { gsap, prefersReducedMotion, revealOnScroll } from '@/lib/gsap'
    import { $ } from '@/lib/dom'

    revealOnScroll('[data-sinopsis-anim]', {
        y: 40,
        autoAlpha: 0,
        duration: 0.8,
        stagger: 0.12,
        scrollTrigger: { trigger: '#sinopsis' }
    })

    revealOnScroll('[data-sinopsis-poster]', {
        y: 60,
        autoAlpha: 0,
        duration: 0.9,
        scrollTrigger: { trigger: '#sinopsis' }
    })

    const section = $('#sinopsis')

    if (section) {
        const spider = $('[data-spider]', section)
        const line = $('[data-spider-line]', section)

        if (spider && line && !prefersReducedMotion()) {
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: section,
                    start: 'top 70%',
                    end: 'bottom 80%',
                    scrub: 1.2,
                }
            })

            tl.to(spider, { autoAlpha: 1, duration: 0.2 }, 0)
            .to(spider, { y: '25vh', x: -6, rotation: -10, ease: 'power1.inOut' }, 0)
            .to(line, { height: '25vh', ease: 'power1.inOut' }, 0)
            .to(spider, { y: '45vh', x: 8, rotation: 12, ease: 'power2.out' })
            .to(line, { height: '45vh', ease: 'power2.out' }, '<')
            .to(spider, { y: '70vh', x: -2, rotation: -4, ease: 'power1.in' })
            .to(line, { height: '70vh', ease: 'power1.in' }, '<')
            .to(spider, { y: '90vh', x: 4, rotation: 6, ease: 'power2.inOut' })
            .to(line, { height: '90vh', ease: 'power2.inOut' }, '<')
            .to(spider, { autoAlpha: 0, duration: 0.3 })
        }
    }
</script>