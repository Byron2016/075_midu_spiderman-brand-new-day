---
import { SEO } from "@/consts"

const RELEASE_DATE = "29.07.26"

const PHRASES = [
  ["El mundo", "ha olvidado", "a Peter"],
  ["pero él", "no los ha", "olvidado"],
]
---

<section data-hero id="trailer" class="relative h-[520vh]">
  <!-- Único h1 del documento. El diseño confía el título al logo de la UI fija,
       así que aquí va sólo para lectores de pantalla y buscadores. -->
  <h1 class="sr-only">{SEO.title}</h1>

  <!-- Marcadores sin pintura: menú / CTA tráiler saben en qué punto del scroll estamos. -->
  <div data-hero-intro class="pointer-events-none absolute inset-x-0 top-0 h-screen" aria-hidden="true"></div>
  <div id="estreno" class="pointer-events-none absolute inset-x-0 top-[18%] h-[40%]" aria-hidden="true"></div>

  <div data-hero-stage class="sticky top-0 h-screen w-full overflow-hidden">
    <div data-hero-media class="absolute inset-0">
      <video
        data-hero-video
        class="absolute inset-0 h-full w-full object-cover"
        muted
        loop
        playsinline
        preload="metadata"
        poster="/images/hero-poster-1280.webp"
        aria-hidden="true"
      >
        <source
          src="/videos/hero-854.webm"
          type='video/webm; codecs="av01.0.04M.08"'
          media="(max-width: 767px)"
        />
        <source
          src="/videos/hero-854.mp4"
          type="video/mp4"
          media="(max-width: 767px)"
        />
        <source
          src="/videos/hero-1920.webm"
          type='video/webm; codecs="av01.0.08M.08"'
        />
        <source src="/videos/hero-1920.mp4" type="video/mp4" />
      </video>
    </div>

    <svg
      data-date-cover
      class="absolute inset-0 h-full w-full opacity-0"
      viewBox="0 0 1000 300"
      preserveAspectRatio="xMidYMid meet"
      aria-hidden="true"
    >
      <defs>
        <filter
          id="hero-date-soft"
          x="-50%"
          y="-50%"
          width="200%"
          height="200%"
        >
          <feGaussianBlur data-date-blur stdDeviation="0"></feGaussianBlur>
        </filter>

        <mask
          id="hero-date-hole"
          maskUnits="userSpaceOnUse"
          x="-2000"
          y="-2000"
          width="5000"
          height="5000"
        >
          <rect x="-2000" y="-2000" width="5000" height="5000" fill="#fff"
          ></rect>
          <text
            data-date-text
            class="font-display"
            x="500"
            y="150"
            text-anchor="middle"
            dominant-baseline="central"
            font-size="250"
            letter-spacing="-6"
            fill="#000"
            fill-opacity="1"
            filter="url(#hero-date-soft)">{RELEASE_DATE}</text
          >
        </mask>
      </defs>

      <rect
        x="-2000"
        y="-2000"
        width="5000"
        height="5000"
        fill="#000004"
        mask="url(#hero-date-hole)"></rect>
    </svg>

    <!-- Por encima del velo de la fecha y por debajo de las frases: cuando
         entra, la fecha ya se ha ido y el velo es negro a pantalla completa.
         El plano viene rodado sobre negro, así que no hace falta recortarlo ni
         fundirlo con nada: apoya sobre el velo sin costura. `preload="none"`
         porque el scrub lo arranca desde el script, y con movimiento reducido
         no llega a pedirse. -->
    <video
      data-hero-swing
      class="absolute inset-0 h-full w-full object-cover opacity-0"
      muted
      playsinline
      preload="none"
      aria-hidden="true"
    >
      <source
        src="/videos/spiderman-jump-810.webm"
        type='video/webm; codecs="av01.0.08M.08"'
        media="(max-width: 767px)"
      />
      <source
        src="/videos/spiderman-jump-810.mp4"
        type="video/mp4"
        media="(max-width: 767px)"
      />
      <source
        src="/videos/spiderman-jump-1440.webm"
        type='video/webm; codecs="av01.0.08M.08"'
      />
      <source src="/videos/spiderman-jump-1440.mp4" type="video/mp4" />
    </video>

    {
      PHRASES.map((lines) => (
        <p
          data-hero-phrase
          class="absolute inset-0 grid place-content-center px-6 text-center text-[clamp(2.5rem,11vw,8rem)] leading-[0.95] font-display uppercase text-neutral-white pointer-events-none"
        >
          {lines.map((line) => (
            <span class="block">{line}</span>
          ))}
        </p>
      ))
    }
  </div>
</section>

<style>
  .video-fallback {
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #0a0a0a 100%);
  }
  .video-fallback::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(180, 30, 30, 0.15) 0%, transparent 70%);
  }
  .video-fallback video {
    opacity: 0;
  }

  /* Sin movimiento, pero no sin contenido. El hero se queda en una pantalla y
     enseña el velo con la fecha ya en su estado final: es la imagen que
     identifica la sección y la única del hero que da el día de estreno.
     Ocultarla dejaba fuera justo lo que la página viene a contar. */
  @media (prefers-reduced-motion: reduce) {
    section[data-hero] {
      height: 100vh;
    }

    /* La timeline abre el velo desde `opacity: 0`; sin timeline hay que
       abrirlo aquí. El resto del estado final ya viene del marcado: el texto
       de la máscara nace a `font-size: 250` y el desenfoque a `0`. */
    [data-date-cover] {
      opacity: 1;
    }

    /* El balanceo se reproduce con scrub contra el scroll: sin timeline no
       tiene un fotograma que enseñar.
       Las frases se van con él. Están superpuestas entre sí y caen sobre la
       fecha, así que en una sola pantalla quieta no caben las dos cosas; entre
       el texto de ambiente y la fecha de estreno, se queda la fecha. */
    [data-hero-swing],
    [data-hero-phrase] {
      display: none;
    }
  }
</style>

<script>
  import { $, $$ } from "@/lib/dom"
  import { gsap, SplitText, prefersReducedMotion } from "@/lib/gsap"
  import { onLoadingReady } from "@/lib/loading"

  const $section = $("[data-hero]") as HTMLElement | null
  const $cover = $("[data-date-cover]") as SVGSVGElement | null
  const $dateText = $("[data-date-text]") as SVGTextElement | null
  const $dateBlur = $("[data-date-blur]") as SVGFEGaussianBlurElement | null
  const $heroVideo = $("[data-hero-video]") as HTMLVideoElement | null
  const $swing = $("[data-hero-swing]") as HTMLVideoElement | null

  const phrases = $$("[data-hero-phrase]")
  const reducedMotion = prefersReducedMotion()

  const BLUR = 24

  const letterDur = 2
  const letterStagger = 0.15
  const hold = 4
  /** Punto de la timeline en el que arrancan las frases. */
  const PHRASE_START = 34

  if ($heroVideo && !reducedMotion) {
    onLoadingReady(() => {
      $heroVideo.play().catch((error) => {
        console.error("Error al reproducir el video del héroe:", error)
        $heroVideo.parentElement?.classList.add("video-fallback")
      })
    })
  }

  if ($section && $cover && $dateText && $dateBlur && !reducedMotion) {
    const tl = gsap.timeline({
      defaults: { ease: "none" },
      scrollTrigger: {
        trigger: $section,
        start: "top top",
        end: "bottom bottom",
        scrub: 0.6,
      },
    })

    tl.fromTo($cover, { opacity: 0 }, { opacity: 1, duration: 12 }, 0)
      .fromTo(
        $dateText,
        { attr: { "font-size": 210 } },
        { attr: { "font-size": 250 }, duration: 22 },
        0,
      )
      .to($dateBlur, { attr: { stdDeviation: BLUR / 3 }, duration: 12 }, 22)
      .to(
        $dateText,
        { attr: { "font-size": 100, "fill-opacity": 0 }, duration: 12 },
        22,
      )

    let phraseAt = PHRASE_START

    phrases.forEach((phrase) => {
      const { chars } = SplitText.create(phrase, { type: "chars" })
      const revealSpan =
        letterDur + Math.max(0, chars.length - 1) * letterStagger

      gsap.set(chars, { opacity: 0 })

      tl.fromTo(
        chars,
        { opacity: 0, filter: `blur(${BLUR}px)` },
        {
          opacity: 1,
          filter: "blur(0px)",
          duration: letterDur,
          stagger: letterStagger,
        },
        phraseAt,
      )

      phraseAt += revealSpan + hold

      tl.to(
        chars,
        {
          opacity: 0,
          filter: `blur(${BLUR}px)`,
          duration: letterDur,
          stagger: { each: letterStagger, from: "start" },
        },
        phraseAt,
      )

      phraseAt += revealSpan
    })

    // El balanceo ocupa exactamente el tramo de las frases: entra con la
    // primera y el plano corto del final cae sobre la salida de la última,
    // que ya termina en negro y enlaza con la sección siguiente.
    //
    // El scrub va contra un objeto intermedio en vez de contra `currentTime`
    // directamente: la duración solo existe tras los metadatos, y el vídeo se
    // pide al vuelo. Con el proxy la timeline se monta entera de una y cada
    // frame resuelve el segundo que toca con lo que haya cargado.
    if ($swing) {
      const swing = { progress: 0 }

      $swing.load()

      tl.fromTo(
        $swing,
        { autoAlpha: 0 },
        { autoAlpha: 1, duration: 2 },
        PHRASE_START,
      )
        .to(
          swing,
          {
            progress: 1,
            duration: phraseAt - PHRASE_START,
            onUpdate: () => {
              if ($swing.readyState < HTMLMediaElement.HAVE_METADATA) return
              $swing.currentTime = swing.progress * $swing.duration
            },
          },
          PHRASE_START,
        )
        .to($swing, { autoAlpha: 0, duration: 2 }, phraseAt - 2)
    }
  }
</script>
