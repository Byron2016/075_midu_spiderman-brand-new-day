---
import Close from '@/assets/icons/close.svg';
import { TRAILER_YOUTUBE } from '@/consts';

const embedSrc = `https://www.youtube-nocookie.com/embed/${TRAILER_YOUTUBE.id}?autoplay=1&start=${TRAILER_YOUTUBE.start}&rel=0&modestbranding=1&playsinline=1`;
---

<!-- El tercer término del `max-w` es el que respeta la altura. El marco es
     `aspect-video`, así que su alto lo decide el ancho; sin este tope, en una
     pantalla baja el vídeo salía más alto que el `max-height: calc(100% - 6px -
     2em)` que el navegador le pone al dialog y el `overflow: hidden` se comía la
     parte de abajo (medido: 104 px de 456, un 23%, en un móvil de 844×390 en
     horizontal). Se acota el ancho en vez del alto porque es el ancho el que
     manda en la proporción: así el vídeo encoge entero y sigue siendo 16:9.
     `dvh` y no `vh` para que cuente la barra del navegador cuando está fuera. -->
<dialog
	data-trailer-modal
	data-embed-src={embedSrc}
	class="trailer-modal m-auto w-full max-w-[min(96vw,56rem,calc((100dvh-6px-2rem)*16/9))] border-0 bg-transparent p-0"
	aria-labelledby="trailer-modal-title"
>
	<!-- La X va en la esquina de la pantalla, alineada con la UI fija (p-4 md:p-6).
	     `fixed` escapa el `overflow: hidden` del dialog porque `.trailer-modal` no
	     tiene transform/filter (el backdrop-filter vive en `::backdrop`) — con
	     `absolute -top-11` el overflow la recortaba entera: invisible e
	     inclickeable, y `showModal()` le daba el foco inicial. -->
	<div class="relative w-full">
		<h2 id="trailer-modal-title" class="sr-only">Tráiler oficial</h2>

		<button
			type="button"
			data-trailer-modal-close
			class="fixed top-4 right-4 md:top-6 md:right-6 z-[1] grid size-10 place-items-center rounded-full bg-neutral-dark/60 text-neutral-white backdrop-blur-md transition-colors hover:bg-neutral-dark/80 focus-visible:bg-neutral-dark/80"
			aria-label="Cerrar tráiler"
		>
			<Close class="size-3.5" aria-hidden="true" />
		</button>

		<div
			class="trailer-modal__frame aspect-video w-full overflow-hidden bg-neutral-black shadow-[0_24px_64px_rgb(0_0_0_/_0.45)]"
			data-trailer-modal-frame
		>
		</div>
	</div>
</dialog>

<style>
	.trailer-modal {
		overflow: hidden;
		scrollbar-width: none;
	}

	.trailer-modal::-webkit-scrollbar {
		display: none;
	}

	.trailer-modal::backdrop {
		background-color: rgb(0 0 4 / 0.86);
		backdrop-filter: blur(6px);
	}

	.trailer-modal__frame :global(iframe) {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>

<script>
	import { $, isDocumentScrollKey } from '@/lib/dom';

	const modal = $<HTMLDialogElement>('[data-trailer-modal]');
	const frame = modal
		? $<HTMLElement>('[data-trailer-modal-frame]', modal)
		: null;
	const closeBtn = modal
		? $<HTMLButtonElement>('[data-trailer-modal-close]', modal)
		: null;
	const src = modal?.dataset.embedSrc;

	if (modal && frame && src) {
		const mount = () => {
			if (frame.querySelector('iframe')) return;
			const iframe = document.createElement('iframe');
			iframe.src = src;
			iframe.title = 'Tráiler oficial de Spider-Man: Brand New Day';
			iframe.allow =
				'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
			iframe.allowFullscreen = true;
			iframe.referrerPolicy = 'strict-origin-when-cross-origin';
			frame.append(iframe);
		};

		const unmount = () => {
			frame.replaceChildren();
		};

		const blockBackgroundScroll = (event: Event) => {
			if (event instanceof WheelEvent && event.ctrlKey) return;
			if (window.TouchEvent && event instanceof TouchEvent && event.touches.length > 1) return;
			event.preventDefault();
		};

		const open = () => {
			mount();
			if (!modal.open) modal.showModal();
			document.addEventListener('wheel', blockBackgroundScroll, {
				passive: false
			});
			document.addEventListener('touchmove', blockBackgroundScroll, {
				passive: false
			});
		};

		const close = () => {
			if (modal.open) modal.close();
		};

		document.addEventListener('click', (event) => {
			const trigger = (event.target as Element | null)?.closest(
				'[data-trailer-open]'
			);
			if (!trigger) return;
			event.preventDefault();
			open();
		});

		closeBtn?.addEventListener('click', close);

		modal.addEventListener('click', (event) => {
			if (event.target === modal) close();
		});

		modal.addEventListener('close', () => {
			unmount();
			document.removeEventListener('wheel', blockBackgroundScroll);
			document.removeEventListener('touchmove', blockBackgroundScroll);
		});

		document.addEventListener('keydown', (event) => {
			if (modal.open && isDocumentScrollKey(event)) event.preventDefault();
		});
	}
</script>
