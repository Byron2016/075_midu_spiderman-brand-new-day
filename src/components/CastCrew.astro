---
import { CAST, CREW, TMDB_IMAGE_BASE } from "@/data/content";
---

<div class="cast-crew">
  <div>
    <h3 class="font-display text-title-small uppercase text-neutral-white">
      Reparto
    </h3>

    <ul
      role="list"
      tabindex="0"
      aria-label="Desplazamiento horizontal del reparto principal"
      class="cast-crew__track"
    >
      {
        CAST.map((person) => (
          <li class="cast-crew__card">
            <img
              src={`${TMDB_IMAGE_BASE}${person.profilePath}`}
              alt={person.name}
              width="300"
              height="450"
              loading="lazy"
              decoding="async"
              class="cast-crew__photo"
            />
            <p class="mt-3 font-display text-body-medium uppercase text-neutral-white">
              {person.name}
            </p>
            <p class="mt-1 font-body text-body-small text-neutral-white/60">
              {person.role}
            </p>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mt-12">
    <h3 class="font-display text-title-small uppercase text-neutral-white">
      Equipo técnico
    </h3>

    <ul
      role="list"
      tabindex="0"
      aria-label="Desplazamiento horizontal del equipo técnico"
      class="cast-crew__track"
    >
      {
        CREW.map((person) => (
          <li class="cast-crew__card">
            <img
              src={`${TMDB_IMAGE_BASE}${person.profilePath}`}
              alt={person.name}
              width="300"
              height="450"
              loading="lazy"
              decoding="async"
              class="cast-crew__photo"
            />
            <p class="mt-3 font-display text-body-medium uppercase text-neutral-white">
              {person.name}
            </p>
            <p class="mt-1 font-body text-body-small text-neutral-white/60">
              {person.role}
            </p>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="mt-10 font-body text-body-small text-neutral-white/40">
    Datos de reparto y equipo técnico proporcionados por {" "}
    <a
      href="https://www.themoviedb.org/movie/969681"
      target="_blank"
      rel="noopener noreferrer"
      class="underline underline-offset-2 hover:text-neutral-white/70">TMDB</a
    >.
  </p>
</div>

<style>
  .cast-crew__track {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding-bottom: 1rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--color-red-light) transparent;
  }

  .cast-crew__track::-webkit-scrollbar {
    height: 6px;
  }

  .cast-crew__track::-webkit-scrollbar-track {
    background: transparent;
  }

  .cast-crew__track::-webkit-scrollbar-thumb {
    background: var(--color-red-light);
    border-radius: 999px;
  }

  .cast-crew__card {
    flex: 0 0 auto;
    width: clamp(7rem, 20vw, 9rem);
    scroll-snap-align: start;
  }

  .cast-crew__photo {
    aspect-ratio: 2 / 3;
    width: 100%;
    object-fit: cover;
    background-color: var(--color-neutral-dark);
    border-bottom: 3px solid var(--color-red-light);
  }
</style>
