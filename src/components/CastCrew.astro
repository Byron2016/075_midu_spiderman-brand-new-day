---
import { CAST, CREW, TMDB_IMAGE_BASE } from "@/data/content";

const GRUPOS = [
  { titulo: "Reparto", personas: CAST },
  { titulo: "Equipo técnico", personas: CREW },
] as const;
---

<div class="cast-crew">
  {
    GRUPOS.map(({ titulo, personas }, index) => (
      <div data-cast-crew-group class:list={[index > 0 && "mt-12"]}>
        <h3 class="font-display text-title-small uppercase text-neutral-white">
          {titulo}
        </h3>

        <ul role="list" tabindex="0" aria-label={titulo} class="cast-crew__track">
          {personas.map((person) => (
            <li class="cast-crew__card">
              <img
                src={`${TMDB_IMAGE_BASE}${person.profilePath}`}
                alt=""
                width="300"
                height="450"
                loading="lazy"
                decoding="async"
                class="cast-crew__photo"
              />
              <p class="mt-3 font-display text-body-medium uppercase text-neutral-white">
                {person.name}
              </p>
              <p class="mt-1 font-body text-body-medium text-neutral-white/60">
                {person.role}
              </p>
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  <div class="mt-10 flex flex-wrap items-center gap-3">
    <a
      href="https://www.themoviedb.org/movie/969681"
      target="_blank"
      rel="noopener noreferrer"
      class="shrink-0 opacity-70 transition-opacity hover:opacity-100"
    >
      <img src="/images/tmdb-logo.svg" alt="TMDB" width="92" height="12" class="h-3 w-auto" />
    </a>
    <p class="font-body text-body-medium text-neutral-white/40">
      This product uses the TMDB API but is not endorsed or certified by TMDB.
    </p>
  </div>
</div>

<style>
  .cast-crew__track {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding-bottom: 1rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--color-red-light) transparent;
  }

  .cast-crew__track::-webkit-scrollbar {
    height: 6px;
  }

  .cast-crew__track::-webkit-scrollbar-track {
    background: transparent;
  }

  .cast-crew__track::-webkit-scrollbar-thumb {
    background: var(--color-red-light);
    border-radius: 999px;
  }

  .cast-crew__track:focus-visible {
    outline: 2px solid var(--color-red-light);
    outline-offset: 2px;
  }

  .cast-crew__card {
    flex: 0 0 auto;
    width: clamp(7rem, 20vw, 9rem);
    scroll-snap-align: start;
  }

  .cast-crew__photo {
    aspect-ratio: 2 / 3;
    width: 100%;
    object-fit: cover;
    background-color: var(--color-neutral-dark);
    border-bottom: 3px solid var(--color-red-light);
  }
</style>
