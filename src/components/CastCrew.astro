---
import { CAST, CREW } from "@/data/content";

const GRUPOS = [
  { titulo: "Reparto", personas: CAST },
  { titulo: "Equipo técnico", personas: CREW },
] as const;

type Foto = { default: ImageMetadata };

const WEBP = import.meta.glob<Foto>("../assets/images/reparto/*.webp", {
  eager: true,
});
const JPG = import.meta.glob<Foto>("../assets/images/reparto/*.jpg", {
  eager: true,
});

const fotoDe = (slug: string) => ({
  webp: WEBP[`../assets/images/reparto/${slug}.webp`]?.default,
  jpg: JPG[`../assets/images/reparto/${slug}.jpg`]?.default,
});
---

<div class="cast-crew">
  {
    GRUPOS.map(({ titulo, personas }, index) => (
      <div data-cast-crew-group class:list={[index > 0 && "mt-12"]}>
        <h3 class="font-display text-title-small uppercase text-neutral-white">
          {titulo}
        </h3>

        <ul
          role="list"
          tabindex="0"
          aria-label={titulo}
          class="cast-crew__track"
        >
          {personas.map((person) => {
            const foto = fotoDe(person.slug);

            return (
              <li class="cast-crew__card">
                <picture>
                  <source srcset={foto.webp?.src} type="image/webp" />
                  <img
                    src={foto.jpg?.src}
                    alt=""
                    width={foto.jpg?.width ?? 300}
                    height={foto.jpg?.height ?? 450}
                    loading="lazy"
                    decoding="async"
                    class="cast-crew__photo"
                  />
                </picture>
                <p class="mt-3 font-display text-body-medium uppercase text-neutral-white">
                  {person.name}
                </p>
                <p class="mt-1 font-body text-body-medium text-neutral-white/60">
                  {person.role}
                </p>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .cast-crew__track {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding-bottom: 1rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--color-red-light) transparent;
  }

  .cast-crew__track::-webkit-scrollbar {
    height: 6px;
  }

  .cast-crew__track::-webkit-scrollbar-track {
    background: transparent;
  }

  .cast-crew__track::-webkit-scrollbar-thumb {
    background: var(--color-red-light);
    border-radius: 999px;
  }

  .cast-crew__track:focus-visible {
    outline: 2px solid var(--color-red-light);
    outline-offset: 2px;
  }

  .cast-crew__card {
    flex: 0 0 auto;
    width: clamp(7rem, 20vw, 9rem);
    scroll-snap-align: start;
    -webkit-user-select: none;
    user-select: none;
  }

  .cast-crew__card picture {
    display: block;
  }

  .cast-crew__photo {
    display: block;
    aspect-ratio: 2 / 3;
    width: 100%;
    object-fit: cover;
    background-color: var(--color-neutral-dark);
    border-bottom: 3px solid var(--color-red-light);
    -webkit-user-drag: none;
    pointer-events: none;
  }
</style>

<script>
  import { dragScroll } from "@/lib/dragScroll";
  import { $$ } from "@/lib/dom";

  for (const track of $$<HTMLElement>(".cast-crew__track")) {
    dragScroll(track);
  }
</script>
